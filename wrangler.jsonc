{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "website",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"r2_buckets": [
		{
			"binding": "OG_IMAGES",
			"bucket_name": "og-images"
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
