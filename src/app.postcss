/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

html,
body {
	overflow: hidden;
}

body {
	background-color: #fff;
	color: #000;
	font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

@media (prefers-color-scheme: dark) {
	body {
		background-color: #000;
		color: #fff;
	}
}

.title:hover {
	animation-name: coolTextThing;
	animation-duration: 1.5s;
	animation-timing-function: ease-out;
}
@keyframes coolTextThing {
	0% {
		font-family: 'Courier New', Courier, monospace;
		font-style: italic;
	}
	10% {
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		font-style: oblique;
	}
	20% {
		font-family: 'Times New Roman', Times, serif;
	}
	30% {
		font-family: Georgia, 'Times New Roman', Times, serif;
	}
	40% {
		font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode',
			Geneva, Verdana, sans-serif;
		font-weight: bold;
	}
	50% {
		font-family: 'Arial Black', Gadget, sans-serif;
		font-weight: bold;
	}
	60% {
		font-family: 'Comic Sans MS', cursive, sans-serif;
	}
	70% {
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-style: oblique;
	}
	80% {
		font-family: 'Lucida Console', Monaco, monospace;
		font-weight: lighter;
	}
	90% {
		font-family: 'MS Sans Serif', Geneva, sans-serif;
		font-weight: 900;
		font-style: italic;
	}
	100% {
		font-family: 'MS Serif', 'New York', sans-serif;
	}
}

@media (prefers-color-scheme: dark) {
	.styled-scrollbars {
		/* Foreground, Background */
		scrollbar-color: var(--purple-400) var(--purple-950);
	}
	.styled-scrollbars::-webkit-scrollbar {
		width: 10px; /* Mostly for vertical scrollbars */
		height: 10px; /* Mostly for horizontal scrollbars */
	}
	.styled-scrollbars::-webkit-scrollbar-thumb {
		/* Foreground */
		background: var(--purple-400);
	}
	.styled-scrollbars::-webkit-scrollbar-track {
		/* Background */
		background: var(--purple-950);
	}
}
.styled-scrollbars {
	/* Foreground, Background */
	scrollbar-color: var(--purple-400) var(--purple-100);
	scrollbar-width: thin;
}
.styled-scrollbars::-webkit-scrollbar {
	width: 5px; /* Mostly for vertical scrollbars */
	height: 5px; /* Mostly for horizontal scrollbars */
}
.styled-scrollbars::-webkit-scrollbar-thumb {
	/* Foreground */
	background: var(--purple-400);
}
.styled-scrollbars::-webkit-scrollbar-track {
	/* Background */
	background: var(--purple-100);
}

code {
  counter-reset: step;
  counter-increment: step 0;
}

code .line::before {
  content: counter(step);
  counter-increment: step;
  width: 1rem;
  margin-right: 1.5rem;
  display: inline-block;
  text-align: right;
  color: rgba(115,138,148,.4)
}

.shiki-code-container {
  position: relative;
  margin-bottom: 1rem;
  /* Inherit background and text color from the Shiki pre element,
     or explicitly set it if you prefer. */
  /* background-color: var(--shiki-color-background, #2d2d2d); */
  /* color: var(--shiki-color-text, #cccccc); */
}

.shiki-code-header {
  /* Use the Shiki background color, potentially a slightly darker/lighter shade */
  /* If --shiki-color-background is not directly available on the parent,
     you might need to target the <pre> element for its computed style. */
  background-color: color-mix(
    in srgb,
    var(--shiki-color-background, #24292e) 80%,
    black
  );
  /* Use a slightly lighter version of the Shiki text color for header text */
  color: color-mix(
    in srgb,
    var(--shiki-color-text, #e1e4e8) 90%,
    white
  );
  padding: 0.5rem 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  font-family: sans-serif;
  font-size: 0.9em;
  user-select: none; /* Prevent selection of header text */
}

.shiki-code-lang-name {
  font-weight: bold;
}

.shiki-copy-button {
  background: none;
  border: none;
  /* Use Shiki text color for the button icon/text */
  color: var(--shiki-color-text, #e1e4e8);
  cursor: pointer;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  display: flex;
  align-items: center;
  gap: 0.5em;
  transition: background-color 0.2s ease;
}

.shiki-copy-button:hover {
  /* Create a subtle hover effect using the background color */
  background-color: color-mix(
    in srgb,
    var(--shiki-color-background, #24292e) 50%,
    white 10%
  );
  /* Ensure text/icon color remains readable on hover */
  color: var(--shiki-color-text, #e1e4e8);
}

/* Style the SVG inside the button */
.shiki-copy-button svg {
  stroke: currentColor; /* Inherit color from parent button */
}

/* Adjust the Shiki pre tag directly within the container */
.shiki-code-container pre.shiki {
  margin-top: 0;
  border-top-left-radius: 0; /* Remove top radius as header has it */
  border-top-right-radius: 0;
  border-bottom-left-radius: 6px;
  border-bottom-right-radius: 6px;
}